# FileGuard Environment Configuration Template
# Copy this file to .env and adjust variables as needed

# Flask environment: 'production' or 'development'
FLASK_ENV=production

# Strong secret key for cryptographic sessions
# On Render, you can leave this blank (Render generates one) or specify a 32+ char hex string
SECRET_KEY=generate_a_random_secret_key_here

# Port to bind (Render automatically sets this)
PORT=5000

# Optional custom directory for SQLite storage (e.g. for Render persistent disks)
# FILEGUARD_DATA_DIR=/var/data
